# Скопируйте в .env: cp .env.example .env. Ключей здесь нет — генерация идёт через вход ChatGPT в Codex
# и сессию Dreamina в Chrome навигатора. Файл .env не публикуется (он в .gitignore).

# Изображения и первые кадры роликов: Astra (gpt-6-astra) через Codex. Пусто — изображения не генерируются,
# блоки заменяются графикой кодом.
MEDIA_IMAGE_GENERATOR=astra-via-codex
# Видео: Seedance 2.5 на сайте Dreamina через Chrome навигатора (ролик 5 с в 1080P ≈ 455 кредитов). Пусто — видео не используется.
MEDIA_VIDEO_GENERATOR=seedance-2-5-in-dreamina
# Сколько позиций prompts.json генерировать одновременно; ролики Dreamina всё равно идут по одному.
MEDIA_GENERATION_PARALLEL=3

# Прокси для сайтов, недоступных напрямую (по желанию), например http://127.0.0.1:8080
PROXY=

# Ключ каталога дизайн-систем DESIGNmd (по желанию; запасной каталог работает без ключа)
DESIGNMD_API_KEY=
